# Copy this file to .env and fill in real values. Never commit the real .env.

# Onshape API key pair — create at https://dev.onshape.com/keys
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Google service account credentials.
# Easiest: download the service account's JSON key file and point to its
# path on disk. Then share the target Google Sheet with the service
# account's email (found inside the JSON as "client_email") like you'd
# share it with any collaborator.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Alternative to the path above: paste the JSON contents directly as a
# single-line string (useful if the deploy environment can't mount a file).
# If both are set, GOOGLE_SERVICE_ACCOUNT_KEY_PATH takes priority.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Port the Node server listens on.
PORT=8787

# PostgreSQL vendor catalog (Section 9).
DATABASE_URL=postgresql://user:password@localhost:5432/onshape_bom
# Set true when using a managed/TLS PostgreSQL endpoint.
DATABASE_SSL=false
